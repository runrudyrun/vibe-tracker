# Vibe-Tracker Environment Configuration
# Copy this file to .env and fill in your actual API keys and preferences

# =============================================================================
# LLM PROVIDER SELECTION
# =============================================================================

# Override automatic provider selection (optional)
# Options: "gemini", "huggingface", "openrouter"
# If not set, will auto-select based on available API keys
LLM_PROVIDER="gemini"

# =============================================================================
# GOOGLE GEMINI CONFIGURATION
# =============================================================================

# Google API Key for Gemini models
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="your_google_api_key_here"

# Gemini model to use (optional, defaults to gemini-2.5-flash)
GOOGLE_MODEL="gemini-2.5-flash"

# =============================================================================
# HUGGING FACE CONFIGURATION
# =============================================================================

# Hugging Face API Token for GPT-OSS and other models
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN="your_huggingface_token_here"

# Hugging Face model to use (optional, defaults to openai/gpt-oss-20b)
HF_MODEL="openai/gpt-oss-120b"

# Provider routing for Hugging Face (optional)
HF_PROVIDER="auto"

# =============================================================================
# OPENROUTER CONFIGURATION
# =============================================================================

# OpenRouter API Key
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# OpenRouter model to use (optional, defaults to gryphe/mythomax-l2-13b)
OPENROUTER_MODEL="openai/gpt-oss-120b"

# Specific provider routing for OpenRouter (optional)
# Examples: "deepinfra", "together", "fireworks"
# Find providers at: https://openrouter.ai/openai/gpt-oss-120b/providers
OPENROUTER_PROVIDER="deepinfra"

# =============================================================================
# RECOMMENDED CONFIGURATIONS
# =============================================================================

# For best dub music generation, recommended models:
# - HF_MODEL="openai/gpt-oss-120b" (most capable for music)
# - GOOGLE_MODEL="gemini-2.5-flash" (fast and reliable fallback)
# - OPENROUTER_MODEL="openai/gpt-oss-120b" (if using OpenRouter)

# For consistent provider routing (prevents model switching):
# - Set OPENROUTER_PROVIDER to your preferred provider
# - Set HF_PROVIDER="auto" for automatic selection
